rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // One document per shared tournament or match, keyed by its random id.
    match /live/{id} {
      function wellFormed() {
        let data = request.resource.data;
        return data.keys().hasOnly(['owner', 'json'])
          && data.owner == request.auth.uid
          && data.json is string
          && data.json.size() < 500000;
      }

      // Anyone holding the link can watch. No `list`: ids can't be browsed.
      allow get: if true;
      // Whoever shares it first owns it; only they can update the score.
      allow create: if request.auth != null && wellFormed();
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && wellFormed();
      // Deleting the game on the organiser's phone takes this copy with it.
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
